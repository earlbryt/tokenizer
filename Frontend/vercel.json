{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://your-api-url.com/api/$1" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/[^.]+", "dest": "/index.html" }
  ]
} 